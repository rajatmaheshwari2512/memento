#!/usr/bin/env bash
# Memento's one command (docs/setup-dev.md).
#
#   ./memento dev up                             start dev, then print the login link
#   ./memento dev down                           stop it; the data stays
#   ./memento dev reset                          stop it and delete .local/dev/
#   ./memento dev logs [service] [--no-follow]   the logs: all, or one (memento-extras, immich-server, ...)
#   ./memento dev status                         what's running, and the link
#   ./memento dev sample-memories                add two "on this day" memories, one with a Memento title
#   ./memento dev config immich|memento [options]   the merged compose files (shows dev's secrets)
#
#   ./memento prod check                         what's missing in .env, and which optional parts are on; changes nothing
#   ./memento prod setup                         installs the tools, fills in the generated settings, makes the server,
#                                                DNS and backup bucket (Terraform: shows the plan, asks), then deploys
#   ./memento prod deploy [--web] [ansible-playbook options]
#                                                sets up the server (Ansible); builds the website first if it isn't
#                                                built, or with --web (a new build is a new website on the server)
#   ./memento prod dry-run                       what deploy and Terraform would change (--check, plan); changes nothing
#   ./memento prod update <version>              runs a release (like v1.2.0) on the server: checks its images are there,
#                                                shows what would change, asks, then sets MEMENTO_VERSION in .env and deploys
#
#   ./memento android                            builds the Android app (apps/android/build.sh)
#   ./memento android keystore                   makes the app's signing key, if there's none
#
# Settings: .env (see .env.example), or for one run: DEV_ML=0 ./memento dev up
# Another settings file: MEMENTO_ENV_FILE=/path/to/file ./memento ...
set -euo pipefail

root="$(cd "$(dirname "$0")" && pwd)"
env_file=${MEMENTO_ENV_FILE:-$root/.env}
case "$env_file" in /*) ;; *) env_file="$PWD/$env_file" ;; esac
dev="$root/.local/dev"
link="http://localhost:8091/__local_login"
python_image="python:3.12-slim@sha256:5e2bdb1b0d542d5039cffb8181c65930093949194a65c365dfb1b0fe13a4fa5b"
extras_defaults="$root/host/roles/memento_extras/defaults/main.yml"
reader_url=$(sed -n 's/^memento_extras_reader_url: *//p' "$extras_defaults" 2>/dev/null || true)
reader_revision=$(sed -n 's/^memento_extras_reader_revision: *//p' "$extras_defaults" 2>/dev/null || true)
reader_files=$(sed -n '/^memento_extras_reader_sha256:/,/^[^ ]/s/^  \([A-Za-z0-9._-]*\): *\([0-9a-f]\{64\}\) *$/\1:\2/p' \
  "$extras_defaults" 2>/dev/null || true)
reader_download="$root/.local/reader-model/$reader_revision"
immich_src="$root/immich"
compose_names="COMPOSE_PROJECT_NAME COMPOSE_FILE COMPOSE_PROFILES COMPOSE_ENV_FILES COMPOSE_PATH_SEPARATOR
IMMICH_VERSION UPLOAD_LOCATION DB_DATA_LOCATION DB_PASSWORD DB_USERNAME DB_DATABASE_NAME DEV_WEB_DIST
MEMENTO_ENV_FILE MEMENTO_DATA MEMENTO_WORK MEMENTO_MUSIC DEV_UID DEV_GID DEV_SESSION_FILE DEV_WEB_UPSTREAM"

say() { printf '%s\n' "$*"; }
fail() {
  printf '\n%s\n' "$*" >&2
  exit 1
}

# file_value NAME FILE: NAME's value in FILE (KEY=value lines; the last one counts), or nothing.
file_value() {
  [ -f "$2" ] || return 0
  sed -n "s/^[[:space:]]*$1=//p" "$2" | tail -n 1 |
    sed -e 's/[[:space:]]#.*$//' -e 's/[[:space:]]*$//' -e 's/^"\(.*\)"$/\1/' -e "s/^'\(.*\)'$/\1/"
}

# setting NAME [default]: from the environment, else from the settings file, else the default.
setting() {
  local value
  value=$(printenv "$1" 2>/dev/null || true)
  [ -n "$value" ] || value=$(file_value "$1" "$env_file")
  printf '%s' "${value:-${2-}}"
}

path_setting() {
  local value
  value=$(setting "$1")
  case "$value" in
    "") ;;
    /*) printf '%s' "$value" ;;
    *) printf '%s' "$root/$value" ;;
  esac
}

load_settings() {
  immich_version=$(sed -n 's/^immich_version: *//p' "$root/host/roles/immich/defaults/main.yml" 2>/dev/null || true)
  [ -n "$immich_version" ] || fail "Can't find immich_version in host/roles/immich/defaults/main.yml."
  web=$(setting DEV_WEB container)
  case "$web" in
    container | dist) ;;
    *) fail "DEV_WEB must be container or dist, not \"$web\"." ;;
  esac
  web_dist=$(path_setting DEV_WEB_DIST)
  [ -n "$web_dist" ] || web_dist="$root/apps/web/dist/$immich_version"
  tz=$(setting DEV_TZ)
  [ -n "$tz" ] || tz=$(readlink /etc/localtime 2>/dev/null | sed -n 's|.*/zoneinfo/||p')
  [ -n "$tz" ] || tz=Etc/UTC
  ml=1
  [ "$(setting DEV_ML 1)" != 0 ] || ml=0
  gemini_key=$(setting DEV_GEMINI_API_KEY)
  night_rules=$(setting DEV_NIGHT_RULES)
  music=$(path_setting MUSIC_DIR)
  if [ -z "$music" ]; then
    music="$root/.local/recap-music/tracks"
    [ -d "$music" ] || music="$dev/music"
  fi
}

generated() {
  sed -n "s/^$1=//p" "$2" 2>/dev/null | tail -n 1
}

sha256_of() {
  if command -v sha256sum >/dev/null 2>&1; then sha256sum "$1"; else shasum -a 256 "$1"; fi | cut -d' ' -f1
}

need_docker() {
  if ! command -v docker >/dev/null 2>&1; then
    fail "MANUAL: install Docker first, then run this again.
  Mac:   Docker Desktop, https://docs.docker.com/desktop/setup/install/mac-install/
  Linux: Docker Engine with the Compose plugin, https://docs.docker.com/engine/install/"
  fi
  local out pid waited=0
  out=$(mktemp)
  docker version --format '{{.Server.Version}}' >"$out" 2>&1 &
  pid=$!
  while kill -0 "$pid" 2>/dev/null && [ "$waited" -lt 20 ]; do
    sleep 1
    waited=$((waited + 1))
  done
  if kill -0 "$pid" 2>/dev/null || ! wait "$pid"; then
    kill "$pid" 2>/dev/null || true
    if grep -q -i "permission denied" "$out"; then
      rm -f "$out"
      fail "MANUAL: your user isn't allowed to use Docker yet. Add it to the docker group, then log out
and back in (or restart), and run this again:
  sudo usermod -aG docker \$USER"
    fi
    rm -f "$out"
    fail "MANUAL: Docker is installed but not answering. Start it and wait until it's running:
  Mac:   open -a Docker   (or open Docker Desktop from Applications)
  Linux: sudo systemctl start docker
Then run this again. If Docker Desktop is open but stuck, quit it and open it again."
  fi
  rm -f "$out"
  local compose
  compose=$(docker compose version --short 2>/dev/null | sed 's/^v//') ||
    fail "MANUAL: Docker's Compose plugin is missing (docker compose). Install it, then run this again."
  if ! printf '%s\n%s\n' 2.24.4 "$compose" | sort -t. -k1,1n -k2,2n -k3,3n -C; then
    fail "MANUAL: Docker Compose $compose is too old; 2.24.4 or newer is needed. Update Docker."
  fi
}

need_setup() {
  [ -f "$dev/memento/compose.env" ] || fail "Dev isn't set up yet: ./memento dev up"
}

need_immich_src() {
  [ -f "$immich_src/docker/docker-compose.yml" ] ||
    fail "Immich's source (with Memento's website and app) isn't in $immich_src/. It comes with the repo as immich/."
}

clean_compose() {
  local unset_args=() name
  for name in $compose_names; do unset_args+=(-u "$name"); done
  env "${unset_args[@]}" BUILDX_NO_DEFAULT_ATTESTATIONS=1 docker compose "$@"
}

immich_compose() {
  need_immich_src
  local files=(-f "$immich_src/docker/docker-compose.yml" -f "$root/deploy/dev/immich.yml")
  if [ "$web" = dist ]; then files+=(-f "$root/deploy/dev/immich-web-dist.yml"); fi
  clean_compose -p immich --project-directory "$dev/immich" --env-file "$dev/immich/.env" \
    --env-file "$dev/immich/compose.env" "${files[@]}" "$@"
}

memento_compose() {
  local files=(-f "$root/deploy/memento/compose.yml" -f "$root/deploy/dev/memento.yml")
  if [ "$web" = container ]; then files+=(-f "$root/deploy/dev/web.yml"); fi
  clean_compose -p memento-extras --project-directory "$root" --env-file "$dev/memento/compose.env" \
    "${files[@]}" "$@"
}

immich_profiles() { if [ "$ml" = 1 ]; then printf '%s\n' --profile ml; fi; }

# foreign_dirs PROJECT DIR: the folders of PROJECT's containers that aren't DIR.
foreign_dirs() {
  docker ps -a --filter "label=com.docker.compose.project=$1" \
    --format '{{.Label "com.docker.compose.project.working_dir"}}' | sort -u | grep -v -x -F "$2" || true
}

stop_hint() {
  local project=$1 dir=$2 clone
  case "$dir" in
    */.local/dev/immich) clone=${dir%/.local/dev/immich} ;;
    *) if [ -x "$dir/memento" ]; then clone=$dir; else clone=""; fi ;;
  esac
  if [ -n "$clone" ]; then say "cd \"$clone\" && ./memento dev down"; else say "docker compose -p $project down"; fi
}

check_clashes() {
  local project dir dirs port users
  for project in immich memento-extras; do
    if [ "$project" = immich ]; then dir="$dev/immich"; else dir="$root"; fi
    dirs=$(foreign_dirs "$project" "$dir")
    if [ -n "$dirs" ]; then
      fail "Another \"$project\" project is on this computer (from $(say "$dirs" | head -n 1)).
Dev uses the same names, so stop it first (its data stays where it is):
  $(stop_hint "$project" "$(say "$dirs" | head -n 1)")"
    fi
  done
  for port in 2283 3005 8091; do
    users=$(docker ps --filter "publish=$port" --format '{{.Names}}' | grep -v -x -E 'immich_server|memento_extras|memento_dev_proxy' || true)
    [ -z "$users" ] || fail "Port $port is taken by another container: $users. Stop it first."
  done
}

check_immich_file() {
  local want got file="$immich_src/docker/docker-compose.yml"
  want=$(sed -n 's/^immich_compose_sha256: *//p' "$root/host/roles/immich/defaults/main.yml")
  got=$(sha256_of "$file")
  [ "$got" = "$want" ] ||
    fail "$file isn't Immich's $immich_version release file, unedited (its sha256 should be immich_compose_sha256 in host/roles/immich/defaults/main.yml)."
}

write_private() {
  (umask 077 && cat > "$1")
}

random_letters() { head -c 1000 /dev/urandom | LC_ALL=C tr -dc 'A-Za-z0-9' | cut -c "1-$1"; }

make_secrets() {
  local file="$dev/secrets.env"
  if [ ! -f "$file" ]; then
    printf 'DB_PASSWORD=%s\n' "$(random_letters 32)" | write_private "$file"
  fi
  if [ -z "$(generated MEMENTO_SECRET "$file")" ]; then
    printf 'MEMENTO_SECRET=%s\n' "$(head -c 32 /dev/urandom | base64)" >> "$file"
  fi
}

write_immich_env() {
  write_private "$dev/immich/.env" <<EOF
# Written by ./memento dev up.
UPLOAD_LOCATION=./library
DB_DATA_LOCATION=./postgres
TZ=$tz
IMMICH_VERSION=$immich_version
DB_PASSWORD=$(generated DB_PASSWORD "$dev/secrets.env")
DB_USERNAME=postgres
DB_DATABASE_NAME=immich
EOF
  write_private "$dev/immich/compose.env" <<EOF
# Written by ./memento dev up.
DEV_WEB_DIST=$web_dist
EOF
}

write_extras_env() {
  local key=$gemini_key url="" quiet=""
  if [ -z "$key" ]; then
    key="dev-fake-gemini-key"
    url="http://fake-gemini:9911/v1beta/interactions"
  fi
  if [ "$night_rules" = 1 ]; then quiet="00:30-07:00"; fi
  {
    printf '# Written by ./memento dev up.\n'
    printf 'GEMINI_API_KEY=%s\n' "$key"
    if [ -n "$url" ]; then printf 'GEMINI_URL=%s\n' "$url"; fi
    printf 'MEMENTO_SECRET=%s\n' "$(generated MEMENTO_SECRET "$dev/secrets.env")"
    printf 'IMMICH_URL=http://immich-server:2283\n'
    printf 'DATA_DIR=/data\nPORT=3005\n'
    printf 'CREATIONS_URL=http://memento-creations:8000\nCREATIONS_WORK_DIR=/work\n'
    printf 'DAILY_LIMIT_PER_USER=10\nMONTHLY_LIMIT_TOTAL=75\n'
    printf 'LIMITS_TIMEZONE=%s\n' "$tz"
    printf 'RENDER_QUIET_HOURS=%s\n' "$quiet"
    printf 'MEMORIES_CHECK_SECONDS=86400\nLIVE_ALBUMS_INTERVAL_SECONDS=86400\n'
  } | write_private "$dev/memento/extras.env"
}

write_compose_env() {
  local upstream=immich-web:3000
  if [ "$web" = dist ]; then upstream=immich-server:2283; fi
  write_private "$dev/memento/compose.env" <<EOF
# Written by ./memento dev up.
MEMENTO_ENV_FILE=$dev/memento/extras.env
MEMENTO_DATA=$dev/memento/data
MEMENTO_WORK=$dev/memento/work
MEMENTO_MUSIC=$music
IMMICH_VERSION=$immich_version
DEV_UID=$(id -u)
DEV_GID=$(id -g)
DEV_SESSION_FILE=$dev/seed/session.env
DEV_WEB_UPSTREAM=$upstream
EOF
}

prepare_web_mounts() {
  local dir
  for dir in node_modules web/node_modules packages/sdk/node_modules packages/sdk/build web/.svelte-kit; do
    mkdir -p "$immich_src/$dir"
  done
}

prepare_files() {
  mkdir -p "$dev"
  chmod 700 "$dev"
  mkdir -p "$dev/immich/library" "$dev/immich/postgres" "$dev/memento/data" "$dev/memento/work" \
    "$dev/seed/photos" "$dev/music"
  [ -f "$dev/seed/session.env" ] || : | write_private "$dev/seed/session.env"
  make_secrets
  write_immich_env
  write_extras_env
  write_compose_env
}

copy_if_changed() {
  cmp -s "$1" "$2" 2>/dev/null || cp "$1" "$2"
}

download_reader() {
  local entry file
  if [ -z "$reader_url" ] || [ -z "$reader_revision" ] || [ -z "$reader_files" ]; then
    fail "Can't find the reader model's pin (memento_extras_reader_*) in $extras_defaults."
  fi
  mkdir -p "$reader_download"
  for entry in $reader_files; do
    file=${entry%%:*}
    [ -f "$reader_download/$file" ] && continue
    say "Downloading Ask's reader model ($file) from Hugging Face..."
    docker run --rm --user "$(id -u):$(id -g)" -v "$reader_download:/out" \
      -v "$root/deploy/dev/fetch.py:/fetch.py:ro" "$python_image" \
      python -I /fetch.py "$reader_url/$reader_revision/$file" "${entry#*:}" "/out/$file" || return 1
  done
}

# Sets reader_dir: READER_MODEL_DIR, else the download; empty if none.
find_reader() {
  local dir file
  reader_dir=""
  dir=$(path_setting READER_MODEL_DIR)
  if [ -n "$dir" ]; then
    for file in config.json tokenizer.json model.onnx; do
      [ -f "$dir/$file" ] || fail "READER_MODEL_DIR ($dir) needs config.json, tokenizer.json and model.onnx."
    done
    reader_dir=$dir
  elif download_reader; then
    reader_dir=$reader_download
  fi
}

stage_reader() {
  local build="$dev/reader-build" src="$root/memento-extras" file
  mkdir -p "$build/model" "$build/reader"
  copy_if_changed "$src/reader/Dockerfile" "$build/Dockerfile"
  copy_if_changed "$src/reader/.dockerignore" "$build/.dockerignore"
  copy_if_changed "$src/reader/requirements.txt" "$build/requirements.txt"
  copy_if_changed "$src/reader/common.py" "$build/common.py"
  for file in "$src/reader/reader/"*.py; do copy_if_changed "$file" "$build/reader/$(basename "$file")"; done
  for file in config.json tokenizer.json model.onnx; do copy_if_changed "$reader_dir/$file" "$build/model/$file"; done
}

make_photos() {
  [ -f "$dev/seed/photos/goa.jpg" ] && return 0
  say "Making the test photos..."
  docker run --rm --user "$(id -u):$(id -g)" -v "$dev/seed/photos:/out" \
    -v "$root/deploy/dev/make-photos.mjs:/make-photos.mjs:ro" \
    --entrypoint node "ghcr.io/immich-app/immich-server:$immich_version" /make-photos.mjs
  if command -v sips >/dev/null 2>&1; then
    sips -s format heic "$dev/seed/photos/goa.jpg" --out "$dev/seed/photos/photo.heic" >/dev/null
  fi
}

seed() {
  docker run --rm --user "$(id -u):$(id -g)" --network immich_default \
    -e IMMICH_API=http://immich-server:2283/api -e DEV_ML="$ml" \
    -v "$dev/seed:/seed" -v "$root/deploy/dev/seed.py:/seed.py:ro" \
    "$python_image" python -I /seed.py /seed
}

up() {
  local started=$SECONDS session timeout=600 profiles=""
  need_docker
  need_immich_src
  check_immich_file
  check_clashes
  if [ "$web" = dist ] && [ ! -f "$web_dist/index.html" ]; then
    fail "DEV_WEB=dist, but $web_dist has no built website. Build it (apps/web/build.sh) or set DEV_WEB_DIST."
  fi
  prepare_files
  if [ "$web" = container ]; then prepare_web_mounts; fi
  if [ -n "$gemini_key" ]; then say "AI Edit uses the REAL Gemini: every edit costs money."; fi

  say "Starting Immich $immich_version (the first time downloads its images, a few GB)..."
  immich_compose up -d --wait --wait-timeout 600 database redis ||
    fail "Immich's database didn't start. If this was the first up, run ./memento dev up again; to see why: ./memento dev logs database"
  # shellcheck disable=SC2046
  immich_compose $(immich_profiles) up -d --wait --wait-timeout 600 ||
    fail "Immich didn't start. If this was the first up, run ./memento dev up again; to see why: ./memento dev logs immich-server"
  if [ "$ml" = 0 ]; then immich_compose --profile ml rm -sf immich-machine-learning >/dev/null 2>&1 || true; fi

  make_photos
  session=$(cksum < "$dev/seed/session.env")
  seed

  find_reader
  if [ -n "$reader_dir" ]; then
    stage_reader
    profiles="--profile reader"
  else
    say ""
    say "WARNING: Ask's reader isn't started (no model)."
    say "Ask still works: it searches the question as typed, without picking out people, dates or places."
    say ""
    memento_compose --profile reader rm -sf memento-reader >/dev/null 2>&1 || true
  fi

  if [ "$(cksum < "$dev/seed/session.env")" != "$session" ]; then
    memento_compose rm -sf proxy >/dev/null 2>&1 || true
  fi
  docker volume inspect memento-extras_web-root-modules >/dev/null 2>&1 || timeout=1800
  say "Building and starting Memento (the first time takes several minutes)..."
  # shellcheck disable=SC2086
  memento_compose $profiles up -d --build --remove-orphans --wait --wait-timeout "$timeout" ||
    fail "Memento didn't start in time. The first up installs the website's packages: if it timed out, run
./memento dev up again. To see why: ./memento dev logs <service> --no-follow"

  say ""
  say "Dev is up after $(((SECONDS - started) / 60))m$(((SECONDS - started) % 60))s. Open: $link"
  say "(Logged in as the test admin. Stop with ./memento dev down; data stays in .local/dev/.)"
}

project_down() {
  if [ -n "$(foreign_dirs "$1" "$2")" ]; then
    say "Left alone: the \"$1\" project on this computer isn't this dev's."
  else
    clean_compose -p "$1" --project-directory "$dev" down
  fi
}

down() {
  need_docker
  [ -d "$dev" ] || { say "Dev isn't set up: nothing to stop."; return 0; }
  project_down memento-extras "$root"
  project_down immich "$dev/immich"
}

reset() {
  if [ -d "$dev" ]; then
    down
    say "Deleting .local/dev/ (dev's photos, database and settings)..."
    if ! rm -rf "$dev" 2>/dev/null; then
      docker run --rm -v "$dev:/dev-data" "ghcr.io/immich-app/immich-server:$immich_version" \
        sh -c 'rm -rf /dev-data/* /dev-data/.[!.]*'
      rm -rf "$dev"
    fi
  fi
  say "Dev is reset. ./memento dev up starts a fresh one (downloads stay, so it's quicker)."
}

logs() {
  need_docker
  need_setup
  local service="" arg follow=(-f)
  for arg in "$@"; do
    case "$arg" in
      --no-follow) follow=() ;;
      *) service=$arg ;;
    esac
  done
  case "$service" in
    "")
      if [ ${#follow[@]} -eq 0 ]; then
        immich_compose --profile ml logs --tail 20
        memento_compose --profile reader logs --tail 20
      else
        trap 'kill 0' INT TERM
        immich_compose --profile ml logs -f --tail 20 &
        memento_compose --profile reader logs -f --tail 20 &
        wait
      fi
      ;;
    immich-server | immich-machine-learning | redis | database)
      immich_compose --profile ml logs ${follow[@]+"${follow[@]}"} --tail 100 "$service" ;;
    *) memento_compose --profile reader logs ${follow[@]+"${follow[@]}"} --tail 100 "$service" ;;
  esac
}

status() {
  need_docker
  [ -f "$dev/memento/compose.env" ] || { say "Dev isn't set up yet: ./memento dev up"; return 0; }
  immich_compose --profile ml ps --format 'table {{.Service}}\t{{.Status}}\t{{.Ports}}'
  memento_compose --profile reader ps --format 'table {{.Service}}\t{{.Status}}\t{{.Ports}}'
  if [ -n "$(docker ps -q --filter name=^memento_dev_proxy$)" ]; then say "" && say "Open: $link"; fi
}

sample_memories() {
  need_docker
  need_setup
  [ -n "$(docker ps -q --filter name=^memento_extras$)" ] || fail "Dev isn't running: ./memento dev up"
  docker run --rm --user "$(id -u):$(id -g)" --network immich_default \
    -e IMMICH_API=http://immich-server:2283/api \
    -v "$dev/seed:/seed:ro" -v "$dev/memento/data:/data" \
    -v "$root/deploy/dev/sample-memories.py:/sample-memories.py:ro" \
    "$python_image" python -I /sample-memories.py /seed /data
}

config() {
  need_docker
  need_setup
  local project=${1-}
  shift || true
  case "$project" in
    immich) immich_compose --profile ml config "$@" ;;
    memento) memento_compose --profile reader config "$@" ;;
    *) fail "Usage: ./memento dev config immich|memento [docker compose config options]" ;;
  esac
}

# ── prod ────────────────────────────────────────────────────────────────────────────────────────

# value NAME [default]: NAME from the settings file only (never the shell), else the default.
value() {
  local v
  v=$(file_value "$1" "$env_file")
  printf '%s' "${v:-${2-}}"
}

expand_home() { case "$1" in "~"/*) printf '%s' "$HOME/${1#"~/"}" ;; *) printf '%s' "$1" ;; esac; }
is_ipv4() { [[ $1 =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]]; }

# oci_value KEY: KEY in the OCI_CONFIG_PROFILE section of ~/.oci/config, or nothing.
oci_value() {
  [ -f "$HOME/.oci/config" ] || return 0
  awk -v section="[$(value OCI_CONFIG_PROFILE DEFAULT)]" -v key="$1" '
    /^[[:space:]]*\[/ { inside = ($0 == section); next }
    inside && $0 ~ "^[[:space:]]*" key "[[:space:]]*=" { sub(/^[^=]*=[[:space:]]*/, ""); sub(/[[:space:]]*$/, ""); print; exit }
  ' "$HOME/.oci/config"
}

load_prod() {
  pipx_bin=${PIPX_BIN_DIR:-$HOME/.local/bin}
  case ":$PATH:" in *":$pipx_bin:"*) ;; *) if [ -d "$pipx_bin" ]; then PATH="$PATH:$pipx_bin"; fi ;; esac
  immich_version=$(sed -n 's/^immich_version: *//p' "$root/host/roles/immich/defaults/main.yml" 2>/dev/null || true)
  [ -n "$immich_version" ] || fail "Can't find immich_version in host/roles/immich/defaults/main.yml."
  web_dist="$root/apps/web/dist/$immich_version"
  plan_file="$root/infra/memento.tfplan"
}

# Sets which optional parts are on (1) or off (0), from the settings file: oracle (setup makes the
# Oracle server), dns (Cloudflare), backups (Ansible's nightly backup), aws (setup makes the bucket).
prod_parts() {
  domain=$(value MEMENTO_DOMAIN)
  server_host=$(value SERVER_HOST)
  oracle=0 dns=0 backups=0 aws=0 server_ipv4=""
  if [ -n "$(value OCI_TENANCY_OCID)" ] && [ -z "$server_host" ]; then oracle=1; fi
  if [ -n "$(value CLOUDFLARE_API_TOKEN)" ]; then dns=1; fi
  if [ -n "$(value BACKUP_BUCKET_NAME)$(value BACKUP_ACCESS_KEY_ID)$(value BACKUP_SECRET_ACCESS_KEY)" ]; then backups=1; fi
  if [ -n "$(value AWS_PROFILE)$(value AWS_ACCESS_KEY_ID)$(value AWS_SECRET_ACCESS_KEY)" ]; then aws=1; fi
  new_bucket=0
  if [ "$backups$aws" = 11 ] && [ -z "$(value BACKUP_ACCESS_KEY_ID)$(value BACKUP_SECRET_ACCESS_KEY)" ]; then new_bucket=1; fi
  zone=$(value CLOUDFLARE_ZONE "${domain#*.}")
  subdomain=${domain%".$zone"}
  if is_ipv4 "$server_host"; then server_ipv4=$server_host; fi
  terraform_on=0
  if [ "$oracle$dns$aws" != 000 ]; then terraform_on=1; fi
  release_settings
}

# Sets release (MEMENTO_VERSION: the release the server runs; empty: built from this checkout) and
# images (where releases' images are: MEMENTO_IMAGES, else ghcr.io/<owner> from the git remote
# origin on GitHub, else empty; in lower case, without a / at the end).
release_settings() {
  local owner
  release=$(value MEMENTO_VERSION)
  images=$(value MEMENTO_IMAGES)
  if [ -z "$images" ]; then
    owner=$(git -C "$root" remote get-url origin 2>/dev/null |
      sed -nE 's#^(git@github\.com:|ssh://git@github\.com/|https://github\.com/)([A-Za-z0-9-]+)/.*#\2#p' || true)
    if [ -n "$owner" ]; then images="ghcr.io/$owner"; fi
  fi
  images=$(printf '%s' "$images" | tr '[:upper:]' '[:lower:]' | sed 's#/*$##')
}

# Notes about the settings for a release: READER_MODEL_DIR isn't used.
release_notes() {
  if [ -n "$release" ] && [ -n "$(value READER_MODEL_DIR)" ]; then
    say "  NOTE: READER_MODEL_DIR is set, but a release doesn't use it: its reader image has the model."
  fi
}

# check_release VERSION: adds to problems what's wrong with running release VERSION.
check_release() {
  [[ $1 =~ ^v[0-9][0-9A-Za-z._-]*$ ]] ||
    problems+=("MEMENTO_VERSION: \"$1\" isn't a release's tag, like v1.2.0 (empty: built from this checkout).")
  if [ -z "$images" ]; then
    problems+=("MEMENTO_IMAGES: empty, and the git remote origin isn't on GitHub. Where the releases' images are, like ghcr.io/<owner>.")
  elif ! [[ $images =~ ^[a-z0-9][a-z0-9._:/-]*$ ]]; then
    problems+=("MEMENTO_IMAGES: \"$images\" isn't an image registry prefix like ghcr.io/<owner>.")
  fi
}

# Fills problems (for the person to fix) and todos (setup fills them in).
check_settings() {
  local v profile key cidr
  problems=() todos=()
  prod_parts
  if [ -z "$domain" ]; then
    problems+=("MEMENTO_DOMAIN: empty. The address people will open, like photos.example.com: a name in a domain you own.")
  elif ! [[ $domain =~ ^[A-Za-z0-9-]+(\.[A-Za-z0-9-]+)+$ ]]; then
    problems+=("MEMENTO_DOMAIN: \"$domain\" isn't a name like photos.example.com.")
  fi
  [ -n "$(value GEMINI_API_KEY)" ] ||
    problems+=("GEMINI_API_KEY: empty. AI Edit's key: aistudio.google.com → Get API key (with billing on; each edit is paid).")
  v=$(value IMMICH_DB_PASSWORD)
  if [ -z "$v" ]; then todos+=(IMMICH_DB_PASSWORD)
  elif ! [[ $v =~ ^[A-Za-z0-9]{16,}$ ]]; then problems+=("IMMICH_DB_PASSWORD: must be 16 or more letters and digits only (Immich's rule).")
  fi
  v=$(value MEMENTO_SECRET)
  if [ -z "$v" ]; then todos+=(MEMENTO_SECRET)
  elif [ "${#v}" -lt 44 ]; then problems+=("MEMENTO_SECRET: must be what openssl rand -base64 32 prints (44 characters).")
  fi
  v=$(value TZ)
  [ -z "$v" ] || [[ $v =~ ^[A-Za-z0-9_+-]+(/[A-Za-z0-9_+-]+)*$ ]] || problems+=("TZ: \"$v\" isn't a time zone like Europe/London.")
  if [ -n "$release" ]; then check_release "$release"; fi
  if [ -f "$keystore" ] && [ -z "$(value ANDROID_KEYSTORE_PASSWORD)" ]; then
    problems+=("ANDROID_KEYSTORE_PASSWORD: empty, but there's a signing key at $keystore. Put its password here
    (from your password manager); setup makes a new password only when there's no key.")
  fi

  if [ -n "$server_host" ] && [ -n "$(value OCI_TENANCY_OCID)" ]; then
    problems+=("SERVER_HOST and OCI_TENANCY_OCID are both set. Setup makes an Oracle server only when SERVER_HOST is empty:
    empty SERVER_HOST to have it make one, or empty the ORACLE settings to use your own server.")
  fi
  if [ "$oracle" = 1 ]; then
    [[ $(value OCI_TENANCY_OCID) == ocid1.tenancy.* ]] ||
      problems+=("OCI_TENANCY_OCID: should start with ocid1.tenancy. (the tenancy= line in ~/.oci/config).")
    profile=$(value OCI_CONFIG_PROFILE DEFAULT)
    if ! grep -qxF "[$profile]" "$HOME/.oci/config" 2>/dev/null; then
      problems+=("OCI_CONFIG_PROFILE: no [$profile] in ~/.oci/config. MANUAL: install Oracle's CLI and run oci setup config,
    then add the public key it makes in Oracle's console (your profile → API keys).")
    elif [ -z "$(value OCI_REGION)$(oci_value region)" ]; then
      problems+=("OCI_REGION: empty, and [$profile] in ~/.oci/config has no region. Your home region, like xx-city-1 (Oracle's console, top right).")
    fi
    key=$(expand_home "$(value SSH_PUBLIC_KEY_PATH "$HOME/.ssh/id_ed25519.pub")")
    [ -f "$key" ] || problems+=("SSH_PUBLIC_KEY_PATH: no file at $key. Make a key: ssh-keygen -t ed25519 (or give the path of your .pub file).")
    cidr=$(value SSH_ALLOWED_CIDR)
    [ -z "$cidr" ] || [[ $cidr =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}/[0-9]{1,2}$ ]] ||
      problems+=("SSH_ALLOWED_CIDR: \"$cidr\" isn't an address range like 203.0.113.7/32.")
    [[ $(value OCI_BUDGET_AMOUNT) =~ ^[1-9][0-9]*$ ]] ||
      problems+=("OCI_BUDGET_AMOUNT: a whole number: the monthly spending alert, in your Oracle account's currency (Billing → Cost Analysis shows which).")
    [[ $(value OCI_BUDGET_EMAIL) == ?*@?* ]] || problems+=("OCI_BUDGET_EMAIL: the email address Oracle sends the spending alert to.")
  fi
  if [ "$dns" = 1 ] && [ -n "$domain" ]; then
    if [[ $zone != *.* ]]; then
      problems+=("CLOUDFLARE_ZONE: MEMENTO_DOMAIN ($domain) gives the zone \"$zone\". Set CLOUDFLARE_ZONE to your domain in Cloudflare, like example.com.")
    elif [ -z "$subdomain" ] || [ "$subdomain" = "$domain" ]; then
      problems+=("CLOUDFLARE_ZONE: \"$zone\" isn't the end of MEMENTO_DOMAIN ($domain). Your domain in Cloudflare, like example.com.")
    fi
    if [ "$oracle" = 0 ] && [ -z "$server_ipv4" ]; then
      problems+=("SERVER_HOST: Cloudflare DNS points MEMENTO_DOMAIN at your server, so SERVER_HOST must be its IPv4 address.
    (Or empty SERVER_HOST and fill in the ORACLE part, to have setup make the server.)")
    fi
  fi
  if [ "$backups" = 1 ]; then
    [ -n "$(value BACKUP_BUCKET_NAME)" ] ||
      problems+=("BACKUP_BUCKET_NAME: empty, but the backup keys are set. The bucket's name.")
    if [ "$aws" = 1 ]; then
      if [ -n "$(value AWS_PROFILE)" ] && [ -n "$(value AWS_ACCESS_KEY_ID)$(value AWS_SECRET_ACCESS_KEY)" ]; then
        problems+=("AWS_PROFILE and AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY are all set: use the profile or the keys, not both.")
      elif [ -n "$(value AWS_PROFILE)" ]; then
        grep -qxF -e "[$(value AWS_PROFILE)]" -e "[profile $(value AWS_PROFILE)]" "$HOME/.aws/credentials" "$HOME/.aws/config" 2>/dev/null ||
          problems+=("AWS_PROFILE: no [$(value AWS_PROFILE)] in ~/.aws/credentials. MANUAL: aws configure --profile $(value AWS_PROFILE), with an admin's access keys.")
      elif [ -z "$(value AWS_ACCESS_KEY_ID)" ] || [ -z "$(value AWS_SECRET_ACCESS_KEY)" ]; then
        problems+=("AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY: fill in both (an admin's access keys: AWS console → IAM → Users → Security credentials).")
      fi
      if [ -z "$(value BACKUP_ACCESS_KEY_ID)" ] || [ -z "$(value BACKUP_SECRET_ACCESS_KEY)" ]; then
        todos+=("BACKUP_ACCESS_KEY_ID and BACKUP_SECRET_ACCESS_KEY (from Terraform, once it has made the backup user)")
      fi
    elif [ -z "$(value BACKUP_ACCESS_KEY_ID)" ] || [ -z "$(value BACKUP_SECRET_ACCESS_KEY)" ]; then
      problems+=("BACKUP_ACCESS_KEY_ID and BACKUP_SECRET_ACCESS_KEY: the keys of an AWS user that may write to the bucket.
    Or fill in AWS_PROFILE (or the AWS keys) and setup makes the bucket and its user.")
    fi
    for key in BACKUP_CRYPT_PASSWORD_OBSCURED BACKUP_CRYPT_PASSWORD2_OBSCURED; do
      if [ -n "$(value "$key")" ]; then continue; fi
      if [ "$new_bucket" = 1 ]; then todos+=("$key")
      else problems+=("$key: empty. It encrypts what's already in your bucket: restore it from your password manager
    (rclone obscure <password> prints the value). Setup makes new ones only when it makes the bucket.")
      fi
    done
  elif [ "$aws" = 1 ]; then
    problems+=("BACKUP_BUCKET_NAME: empty, but the AWS settings are set. The name setup should give the bucket: unique across all of AWS,
    like memento-backup-<random letters>.")
  fi
}

show_parts() {
  local server
  if [ "$oracle" = 1 ]; then server="on: setup makes the Oracle server, its network and a spending alert."
  elif [ -n "$server_host" ]; then server="off: your own server, at SERVER_HOST."
  else server="off: your own server, at MEMENTO_DOMAIN (fill in the ORACLE part to have setup make one)."
  fi
  say "Optional parts:"
  say "  Oracle server    $server"
  if [ "$dns" = 1 ]; then say "  Cloudflare DNS   on: setup points MEMENTO_DOMAIN at the server: record \"$subdomain\" in zone $zone."
  else say "  Cloudflare DNS   off: MANUAL: at your DNS provider, point MEMENTO_DOMAIN at the server (an A record)."
  fi
  if [ "$backups" = 0 ]; then say "  Backups          off: WARNING: no off-site copy of the photos (fill in the BACKUPS part)."
  elif [ "$aws" = 1 ]; then say "  Backups          on: nightly to S3 Glacier Deep Archive; setup makes the bucket and its user."
  else say "  Backups          on: nightly to S3 Glacier Deep Archive, to the bucket you made."
  fi
  if [ -n "$release" ]; then say "  Release          $release: the server pulls Memento's images from ${images:-MEMENTO_IMAGES}."
  else say "  Release          off: Memento is built from this checkout (MEMENTO_VERSION empty)."
  fi
  release_notes
}

show_check() {
  local line
  say "Settings: $env_file"
  say ""
  show_parts
  if [ ${#problems[@]} -gt 0 ]; then
    say ""
    say "To fill in or fix (.env.example says what each one is):"
    for line in "${problems[@]}"; do say "  - $line"; done
  fi
  if [ ${#todos[@]} -gt 0 ]; then
    say ""
    say "./memento prod setup fills in:"
    for line in "${todos[@]}"; do say "  - $line"; done
  fi
}

prod_check() {
  [ -f "$env_file" ] || fail "No settings file at $env_file. cp .env.example .env and fill in the PROD part
(or ./memento prod setup makes it)."
  check_settings
  show_check
  if [ ${#problems[@]} -gt 0 ]; then fail "Not ready: ${#problems[@]} to fill in or fix."; fi
  if [ ${#todos[@]} -gt 0 ]; then fail "Not ready yet: ./memento prod setup fills in the rest."; fi
  say ""
  say "Ready: ./memento prod setup (or ./memento prod deploy if the server and DNS are there already)."
}

need_ready() {
  [ -f "$env_file" ] || fail "No settings file at $env_file: ./memento prod setup makes one."
  check_settings
  if [ ${#problems[@]} -gt 0 ] || [ ${#todos[@]} -gt 0 ]; then
    show_check
    fail "Not ready: fix the settings above first (./memento prod check)."
  fi
}

# set_value NAME VALUE: writes NAME=VALUE into the settings file, on NAME's last line, else at the end.
set_value() {
  local line tmp
  line=$(grep -n "^[[:space:]]*$1=" "$env_file" | tail -n 1 | cut -d: -f1 || true)
  tmp=$(mktemp "$env_file.XXXXXX")
  if [ -n "$line" ]; then
    NEW_LINE="$1=$2" awk -v n="$line" 'NR == n { print ENVIRON["NEW_LINE"]; next } { print }' "$env_file" > "$tmp"
  else
    { cat "$env_file"; if [ -n "$(tail -c 1 "$env_file")" ]; then echo; fi; printf '%s=%s\n' "$1" "$2"; } > "$tmp"
  fi
  cat "$tmp" > "$env_file"
  rm -f "$tmp"
  say "  $1 added to $env_file"
}

# fill NAME VALUE: set_value, only when NAME is empty.
fill() { if [ -z "$(value "$1")" ]; then set_value "$1" "$2"; fi; }

new_secret() { openssl rand -base64 32 2>/dev/null || head -c 32 /dev/urandom | base64; }

# secret_names: the settings fill_secrets makes, when empty.
secret_names() {
  printf '%s\n' IMMICH_DB_PASSWORD MEMENTO_SECRET
  if [ "$new_bucket" = 1 ]; then printf '%s\n' BACKUP_CRYPT_PASSWORD_OBSCURED BACKUP_CRYPT_PASSWORD2_OBSCURED; fi
  if [ ! -e "$keystore" ]; then printf '%s\n' ANDROID_KEYSTORE_PASSWORD; fi
}

fill_secrets() {
  local plain1="" plain2="" name missing=0
  for name in $(secret_names); do
    [ -n "$(value "$name")" ] || missing=1
  done
  if [ "$missing" = 0 ]; then
    say "Generated settings: all there."
    return 0
  fi
  say "== Generated settings (only the empty ones)"
  fill IMMICH_DB_PASSWORD "$(random_letters 40)"
  fill MEMENTO_SECRET "$(new_secret)"
  if [ "$new_bucket" = 1 ] && [ -z "$(value BACKUP_CRYPT_PASSWORD_OBSCURED)" ]; then
    plain1=$(random_letters 40)
    set_value BACKUP_CRYPT_PASSWORD_OBSCURED "$(printf '%s' "$plain1" | rclone obscure -)"
  fi
  if [ "$new_bucket" = 1 ] && [ -z "$(value BACKUP_CRYPT_PASSWORD2_OBSCURED)" ]; then
    plain2=$(random_letters 40)
    set_value BACKUP_CRYPT_PASSWORD2_OBSCURED "$(printf '%s' "$plain2" | rclone obscure -)"
  fi
  if [ ! -e "$keystore" ]; then fill ANDROID_KEYSTORE_PASSWORD "$(random_letters 40)"; fi
  if [ -n "$plain1$plain2" ]; then
    say ""
    say "SAVE THESE NOW, in your password manager. They're shown only this once."
    say "The backups are encrypted with them; without them (or .env) nobody can read the backups:"
    if [ -n "$plain1" ]; then say "  backup password 1: $plain1"; fi
    if [ -n "$plain2" ]; then say "  backup password 2: $plain2"; fi
    say ""
  fi
}

# Installs what's missing: Ansible, Terraform when a Terraform part is on, rclone for new backup passwords.
install_tools() {
  local tool missing=() wanted=(ansible-playbook)
  if [ "$terraform_on" = 1 ]; then wanted+=(terraform); fi
  if [ "$new_bucket" = 1 ] && { [ -z "$(value BACKUP_CRYPT_PASSWORD_OBSCURED)" ] || [ -z "$(value BACKUP_CRYPT_PASSWORD2_OBSCURED)" ]; }; then
    wanted+=(rclone)
  fi
  for tool in "${wanted[@]}"; do command -v "$tool" >/dev/null 2>&1 || missing+=("$tool"); done
  [ ${#missing[@]} -gt 0 ] || return 0
  say "== Installing: ${missing[*]}"
  if [ "$(uname -s)" = Darwin ]; then
    command -v brew >/dev/null 2>&1 || fail "MANUAL: install Homebrew (https://brew.sh), then run this again."
    for tool in "${missing[@]}"; do
      case "$tool" in
        terraform) brew install hashicorp/tap/terraform ;;
        ansible-playbook) brew install ansible ;;
        *) brew install "$tool" ;;
      esac
    done
  elif command -v apt-get >/dev/null 2>&1; then
    sudo apt-get update
    for tool in "${missing[@]}"; do
      case "$tool" in
        terraform)
          sudo apt-get install -y curl gpg
          curl -fsSL https://apt.releases.hashicorp.com/gpg | sudo gpg --dearmor --yes -o /usr/share/keyrings/hashicorp-archive-keyring.gpg
          echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/hashicorp-archive-keyring.gpg] https://apt.releases.hashicorp.com $(sed -n 's/^VERSION_CODENAME=//p' /etc/os-release) main" |
            sudo tee /etc/apt/sources.list.d/hashicorp.list >/dev/null
          sudo apt-get update
          sudo apt-get install -y terraform
          ;;
        ansible-playbook)
          sudo apt-get install -y pipx
          pipx install --include-deps ansible
          pipx ensurepath >/dev/null || true
          case ":$PATH:" in *":$pipx_bin:"*) ;; *) PATH="$PATH:$pipx_bin" ;; esac
          say "Ansible is in $pipx_bin: ./memento finds it there; for ansible-playbook itself, open a new terminal."
          ;;
        *) sudo apt-get install -y "$tool" ;;
      esac
    done
  else
    fail "MANUAL: install ${missing[*]} (Terraform: developer.hashicorp.com/terraform/install;
Ansible: docs.ansible.com; rclone: rclone.org/install), then run this again."
  fi
}

# tf ARGS...: terraform in infra/, with only the settings it needs from the settings file.
tf() {
  (
    while IFS= read -r name; do unset "$name"; done < <(env | sed -nE 's/^((TF_VAR|AWS|CLOUDFLARE|OCI)_[A-Za-z0-9_]*)=.*/\1/p')
    for entry in "${tf_env[@]}"; do export "${entry?}"; done
    terraform -chdir="$root/infra" "$@"
  )
}

set_tf_env() {
  local on=(false true)
  tf_env=("TF_VAR_oracle_server=${on[$oracle]}" "TF_VAR_cloudflare_dns=${on[$dns]}" "TF_VAR_aws_backup=${on[$aws]}")
  if [ "$oracle" = 1 ]; then
    tf_env+=("TF_VAR_oci_tenancy_ocid=$(value OCI_TENANCY_OCID)" "TF_VAR_oci_config_profile=$(value OCI_CONFIG_PROFILE DEFAULT)"
      "TF_VAR_oci_region=$(value OCI_REGION "$(oci_value region)")"
      "TF_VAR_budget_amount=$(value OCI_BUDGET_AMOUNT)" "TF_VAR_budget_alert_email=$(value OCI_BUDGET_EMAIL)")
    if [ -n "$(value SSH_PUBLIC_KEY_PATH)" ]; then tf_env+=("TF_VAR_ssh_public_key_path=$(value SSH_PUBLIC_KEY_PATH)"); fi
    if [ -n "$(value SSH_ALLOWED_CIDR)" ]; then tf_env+=("TF_VAR_ssh_allowed_cidr=$(value SSH_ALLOWED_CIDR)"); fi
  fi
  if [ "$dns" = 1 ]; then
    tf_env+=("TF_VAR_domain=$zone" "TF_VAR_subdomains=[\"$subdomain\"]" "TF_VAR_server_ipv4=$server_ipv4"
      "CLOUDFLARE_API_TOKEN=$(value CLOUDFLARE_API_TOKEN)")
  fi
  if [ "$aws" = 1 ]; then
    tf_env+=("TF_VAR_backup_bucket_name=$(value BACKUP_BUCKET_NAME)" "TF_VAR_aws_region=$(value AWS_REGION us-east-1)"
      "TF_VAR_aws_profile=$(value AWS_PROFILE)")
    if [ -z "$(value AWS_PROFILE)" ]; then
      tf_env+=("AWS_ACCESS_KEY_ID=$(value AWS_ACCESS_KEY_ID)" "AWS_SECRET_ACCESS_KEY=$(value AWS_SECRET_ACCESS_KEY)")
    fi
  fi
}

# Stops when Terraform's state has a part that .env now turns off: Terraform would delete it.
# Keeps the state's addresses in tf_state ("" without infra/terraform.tfstate).
check_state() {
  local state
  tf_state=""
  [ -f "$root/infra/terraform.tfstate" ] || return 0
  state=$(tf state list) || fail "terraform state list failed (above), and setup's checks need it. To see why: cd infra && terraform state list"
  tf_state=$state
  if [ "$oracle" = 0 ] && grep -q -e '^module\.oci_vm' -e '^oci_identity_compartment' <<<"$state"; then
    fail "Terraform's state has the Oracle server, but .env turns that part off (SERVER_HOST is set, or OCI_TENANCY_OCID
is empty), so Terraform would delete it. Fill in the ORACLE part and leave SERVER_HOST empty."
  fi
  if [ "$dns" = 0 ] && grep -q '^module\.dns' <<<"$state"; then
    fail "Terraform's state has the Cloudflare DNS record, but CLOUDFLARE_API_TOKEN is empty, so Terraform would delete it.
Fill in CLOUDFLARE_API_TOKEN."
  fi
  if [ "$aws" = 0 ] && grep -q '^module\.backup' <<<"$state"; then
    fail "Terraform's state has the backup bucket and its user, but AWS_PROFILE (or the AWS keys) is empty, so Terraform
would delete them. Fill in AWS_PROFILE or AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY."
  fi
}

tf_ready() {
  command -v terraform >/dev/null 2>&1 || fail "Terraform isn't installed: ./memento prod setup installs it."
  set_tf_env
  say "== Terraform: init"
  tf init -input=false >/dev/null || fail "terraform init failed. To see why: cd infra && terraform init"
  check_state
}

# The plan, shown, then applied only after the person types yes (new server, for a new server).
terraform_apply() {
  local rc=0 verdict refused answer confirm=yes
  vm_created=0
  tf_ready
  say "== Terraform: plan"
  tf plan -input=false -out="$plan_file" -detailed-exitcode || rc=$?
  case "$rc" in
    0) say "Terraform: nothing to change." ;;
    2)
      verdict=$(tf show -json "$plan_file" | STATE="$tf_state" python3 -I -c 'import json, os, sys
known = set(os.environ["STATE"].splitlines())
for change in json.load(sys.stdin).get("resource_changes", []):
    actions, address = change["change"]["actions"], change["address"]
    if "delete" in actions:
        print("refuse   deletes: " + address)
    elif "create" in actions and address in known:
        print("refuse   makes again (the state has it): " + address)
    elif "create" in actions and change.get("type") == "oci_core_instance":
        print("new-server")')
      refused=$(sed -n 's/^refuse //p' <<<"$verdict")
      if [ -n "$refused" ]; then
        rm -f "$plan_file"
        fail "This plan:
$refused
Setup never applies that. Check .env: a part turned off, or another region or account than before?
To do it anyway, run terraform in infra/ yourself."
      fi
      [ -t 0 ] || { rm -f "$plan_file"; fail "Setup asks you to type yes before Terraform changes anything: run it in a terminal."; }
      if grep -qx new-server <<<"$verdict"; then
        confirm="new server"
        say ""
        if [ -z "$tf_state" ]; then say "There's no Terraform state here (infra/terraform.tfstate): this makes a NEW server (pay-as-you-go)."
        else say "This makes a NEW server (pay-as-you-go)."
        fi
      fi
      printf '\nMake these changes? Type %s to go ahead (anything else stops): ' "$confirm"
      read -r answer || answer=""
      if [ "$answer" != "$confirm" ]; then
        rm -f "$plan_file"
        fail "Stopped: Terraform changed nothing."
      fi
      tf apply -input=false "$plan_file" || { rm -f "$plan_file"; fail "terraform apply failed (above)."; }
      if [ "$confirm" = "new server" ]; then vm_created=1; fi
      ;;
    *) rm -f "$plan_file"; fail "terraform plan failed (above)." ;;
  esac
  rm -f "$plan_file"
}

# After Terraform: the backup user's keys into .env; deploy_host, the Oracle server's address for the
# deploy, when it's new or MEMENTO_DOMAIN doesn't point at it yet.
after_terraform() {
  local ip
  deploy_host=""
  if [ "$aws" = 1 ]; then
    fill BACKUP_ACCESS_KEY_ID "$(tf output -raw backup_access_key_id 2>/dev/null || true)"
    fill BACKUP_SECRET_ACCESS_KEY "$(tf output -raw backup_secret_access_key 2>/dev/null || true)"
  fi
  if [ "$oracle" = 1 ]; then
    ip=$(tf output -raw vm_public_ip 2>/dev/null || true)
    [ -n "$ip" ] || fail "Terraform has no address for the Oracle server (terraform output vm_public_ip)."
    say "The Oracle server's address: $ip"
    if [ "$vm_created" = 1 ] || [ "$(resolve "$domain")" != "$ip" ]; then
      wait_for_ssh "$ip"
      deploy_host=$ip
    fi
  fi
}

# wait_for_ssh ADDRESS: waits until ADDRESS answers on port 22, at most 5 minutes.
wait_for_ssh() {
  say "Waiting for the server at $1 to answer on port 22 (up to 5 minutes)..."
  python3 -I -c 'import socket, sys, time
deadline = time.time() + 300
while True:
    try:
        socket.create_connection((sys.argv[1], 22), timeout=5).close()
        break
    except OSError:
        if time.time() > deadline:
            sys.exit(1)
        time.sleep(5)' "$1" ||
    fail "The server at $1 doesn't answer on port 22 after 5 minutes. Check it's running (Oracle's console →
Compute → Instances), then run ./memento prod setup again."
}

resolve() { python3 -I -c 'import socket, sys; print(socket.gethostbyname(sys.argv[1]))' "$1" 2>/dev/null || true; }

ansible_run() {
  local extra=()
  command -v ansible-playbook >/dev/null 2>&1 || fail "Ansible isn't installed: ./memento prod setup installs it."
  if [ -n "$release" ]; then extra=(-e "memento_images=$images"); fi
  (cd "$root/host" && MEMENTO_ENV_FILE="$env_file" ansible-playbook "$@" ${extra[@]+"${extra[@]}"})
}

prod_setup() {
  if [ ! -f "$env_file" ]; then
    (umask 077 && cp "$root/.env.example" "$env_file")
    say "Made $env_file from .env.example."
  fi
  prod_parts
  install_tools
  fill_secrets
  check_settings
  if [ ${#problems[@]} -gt 0 ]; then
    show_check
    fail "Fill these in, then run ./memento prod setup again (it carries on where it stopped)."
  fi
  show_parts
  deploy_host=""
  if [ "$terraform_on" = 1 ]; then
    terraform_apply
    after_terraform
  else
    say "Terraform: nothing to make (no Oracle, Cloudflare or AWS settings)."
  fi
  if [ -n "$deploy_host" ]; then prod_deploy -e "ansible_host=$deploy_host"; else prod_deploy; fi
  say ""
  say "Memento is at https://$domain. Still by hand (MANUAL):"
  if [ "$dns" = 0 ] && [ -n "$deploy_host" ]; then
    say "  - At your domain's DNS provider, add an A record: $domain → $deploy_host (DNS only, no proxy)."
    say "    HTTPS starts working once it's there; later deploys reach the server at $domain."
  fi
  say "  - Open it and make the admin account: the first person to sign up is the admin."
  say "  - Music for recap videos (optional): deploy/music/tracks.md, then ./memento prod deploy."
  say "  - The Android app: ./memento android keystore (once), then ./memento android."
}

prod_deploy() {
  local arg build=0 args=()
  for arg in "$@"; do
    if [ "$arg" = --web ]; then build=1; else args+=("$arg"); fi
  done
  need_ready
  if [ -n "$release" ]; then
    if [ "$build" = 1 ]; then say "--web: nothing to build: release $release has its website in memento-server."; fi
  elif [ "$build" = 1 ] || [ ! -f "$web_dist/index.html" ] || [ ! -f "$web_dist.build.json" ]; then
    need_docker
    say "== Building the website (apps/web/build.sh)"
    env -u WEB_BUILD_DIR "$root/apps/web/build.sh"
  fi
  if [ "$backups" = 0 ]; then say "WARNING: no backups: nothing is copied off the server (BACKUPS in .env.example)."; fi
  say "== Setting up the server (Ansible)"
  ansible_run site.yml --diff ${args[@]+"${args[@]}"}
}

prod_dry_run() {
  need_ready
  if [ -z "$release" ] && { [ ! -f "$web_dist/index.html" ] || [ ! -f "$web_dist.build.json" ]; }; then
    fail "The website isn't built yet ($web_dist): ./memento prod deploy builds it first, or run apps/web/build.sh."
  fi
  if [ "$terraform_on" = 1 ]; then
    tf_ready
    say "== Terraform: plan (changes nothing)"
    tf plan -input=false
  else
    say "Terraform: off (no Oracle, Cloudflare or AWS settings)."
  fi
  say "== Ansible: --check (changes nothing)"
  ansible_run site.yml --check
}

# prod update VERSION: runs release VERSION on the server. Checks its four images can be pulled
# without logging in (as the server pulls them), shows what the deploy would change, asks for yes,
# then sets MEMENTO_VERSION in the settings file (that line only) and deploys.
prod_update() {
  local version=${1-} log answer release_immich packages="github.com/<owner>?tab=packages"
  if [ $# -ne 1 ] || [ -z "$version" ]; then fail "Usage: ./memento prod update <version>, a release's tag like v1.2.0."; fi
  need_ready
  problems=()
  release=$version
  check_release "$version"
  if [ ${#problems[@]} -gt 0 ]; then fail "${problems[*]}"; fi
  [ -t 0 ] || fail "Update asks you to type yes before it deploys: run it in a terminal."
  release_notes
  if ! git -C "$root" rev-parse -q --verify "refs/tags/$version" > /dev/null; then
    say "== Fetching the tag $version from origin"
    git -C "$root" fetch --quiet origin "refs/tags/$version:refs/tags/$version" ||
      fail "There's no tag $version here or on origin. Is it a release? (git ls-remote --tags origin lists them.)"
  fi
  release_immich=$(git -C "$root" show "refs/tags/$version:host/roles/immich/defaults/main.yml" 2>/dev/null |
    sed -n 's/^immich_version: *//p' || true)
  [ -n "$release_immich" ] || fail "Can't read immich_version from release $version (host/roles/immich/defaults/main.yml)."
  if [ "$release_immich" != "$immich_version" ]; then
    fail "Release $version runs Immich $release_immich, but this checkout is set up for Immich $immich_version, and the
server setup comes from this checkout. Check it out first (git checkout $version), then run this again. Nothing was changed."
  fi
  case "$images" in ghcr.io/*) packages="github.com/${images#ghcr.io/}?tab=packages" ;; esac
  say "== Release $version: are its images at $images? (checked without logging in, as the server pulls them)"
  python3 -I "$root/scripts/check-release.py" "$images" "$version" ||
    fail "Release $version isn't there for anyone to pull. Its images come from the repo's Release workflow (GitHub →
Actions → Release, the run that made $version): did it run, and finish? GitHub may make a new package private: make each one
public ($packages → the package → Package settings → Change visibility). Nothing was changed."
  if ! git -C "$root" tag --points-at HEAD 2>/dev/null | grep -qxF "$version"; then
    say "NOTE: this checkout isn't at $version, and the server setup (host/) and immich_version come from it."
    say "      To match the release: git fetch --tags && git checkout $version (or git pull for a newer one)."
  fi
  say "== What the deploy would change (Ansible --check; changes nothing)"
  log=$(mktemp)
  if ! ansible_run site.yml --check -e "memento_version=$version" > "$log" 2>&1; then
    tail -n 40 "$log"
    rm -f "$log"
    fail "The dry-run failed (above). Nothing was changed."
  fi
  awk '/^TASK \[/ { task = $0; sub(/^TASK \[/, "", task); sub(/\] \**$/, "", task); next }
       /^changed: / && task != "" { print "  would change: " task; task = "" }
       /^PLAY RECAP/ { recap = 1 }
       recap && NF { print "  " $0 }' "$log"
  rm -f "$log"
  printf '\nRun Memento %s on the server? Type yes to go ahead (anything else stops): ' "$version"
  read -r answer || answer=""
  [ "$answer" = yes ] || fail "Stopped: nothing was changed."
  set_value MEMENTO_VERSION "$version"
  prod_deploy
}

# ── android ─────────────────────────────────────────────────────────────────────────────────────

load_android() {
  keystore=$(expand_home "$(value ANDROID_KEYSTORE_PATH "$HOME/.config/memento/android/memento.jks")")
  case "$keystore" in /*) ;; *) keystore="$root/$keystore" ;; esac
  key_alias=$(value ANDROID_KEYSTORE_ALIAS memento)
}

android_build() {
  [ -f "$keystore" ] || fail "No signing key at $keystore. Make one: ./memento android keystore
(or set ANDROID_KEYSTORE_PATH in .env to yours)."
  [ -n "$(value ANDROID_KEYSTORE_PASSWORD)" ] || fail "ANDROID_KEYSTORE_PASSWORD is empty in $env_file."
  MEMENTO_ENV_FILE="$env_file" "$root/apps/android/build.sh"
}

android_keystore() {
  local keytool=(keytool)
  if [ -e "$keystore" ]; then
    say "There's a signing key at $keystore already: left as it is (never replaced)."
    return 0
  fi
  if ! keytool -help >/dev/null 2>&1; then
    keytool=(mise -C "$root/immich/mobile" exec -- keytool)
    MISE_AUTO_INSTALL=false MISE_EXEC_AUTO_INSTALL=false "${keytool[@]}" -help >/dev/null 2>&1 ||
      fail "MANUAL: keytool comes with Java. Install a JDK (Mac: brew install openjdk; Ubuntu: sudo apt install default-jdk-headless),
or the Android build's tools (apps/android/build.sh, one-time setup), then run this again."
  fi
  if [ ! -f "$env_file" ]; then
    (umask 077 && cp "$root/.env.example" "$env_file")
    say "Made $env_file from .env.example."
  fi
  fill ANDROID_KEYSTORE_PASSWORD "$(random_letters 40)"
  (umask 077 && mkdir -p "$(dirname "$keystore")")
  MEMENTO_KEYSTORE_PASSWORD=$(value ANDROID_KEYSTORE_PASSWORD) MISE_AUTO_INSTALL=false MISE_EXEC_AUTO_INSTALL=false \
    "${keytool[@]}" -genkeypair -noprompt -keystore "$keystore" -storetype PKCS12 -alias "$key_alias" \
    -keyalg RSA -keysize 4096 -validity 10000 -dname "CN=Memento" \
    -storepass:env MEMENTO_KEYSTORE_PASSWORD -keypass:env MEMENTO_KEYSTORE_PASSWORD >/dev/null
  chmod 600 "$keystore"
  say "Made the signing key: $keystore (alias $key_alias; its password is ANDROID_KEYSTORE_PASSWORD)."
  say "MANUAL: back up the key file and its password. Every update of the app must be signed with this same key."
}

usage() {
  sed -n '2,/^set -euo/p' "$0" | sed -e '$d' -e 's/^# \{0,1\}//'
  exit 1
}

[ "$(id -u)" != 0 ] || fail "Don't run ./memento as root or with sudo: dev's files must belong to you.
On Linux, if Docker says \"permission denied\", see docs/setup-dev.md (the docker group)."
case "${1-}" in
  dev)
    load_settings
    case "${2-}" in
      up) up ;;
      down) down ;;
      reset) reset ;;
      logs)
        shift 2
        logs "$@"
        ;;
      status) status ;;
      sample-memories) sample_memories ;;
      config)
        shift 2
        config "$@"
        ;;
      *) usage ;;
    esac
    ;;
  prod)
    load_prod
    load_android
    case "${2-}" in
      check) prod_check ;;
      setup) prod_setup ;;
      deploy)
        shift 2
        prod_deploy "$@"
        ;;
      dry-run) prod_dry_run ;;
      update)
        shift 2
        prod_update "$@"
        ;;
      *) usage ;;
    esac
    ;;
  android)
    load_android
    case "${2-}" in
      "") android_build ;;
      keystore) android_keystore ;;
      *) usage ;;
    esac
    ;;
  *) usage ;;
esac
