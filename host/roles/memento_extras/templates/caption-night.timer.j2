# Managed by Ansible (host/roles/memento_extras). Changes made on the server are overwritten.
# See when it runs next: systemctl list-timers caption-night.timer
[Unit]
Description=Nightly captions for new photos (Memento)

[Timer]
OnCalendar=*-*-* {{ memento_extras_captions_start }}:00
# Not Persistent: a run missed while the VM was off waits for the next night.

[Install]
WantedBy=timers.target
