# Managed by Ansible (host/roles/memento_extras). Changes made on the server are overwritten.
# Run by hand:  sudo systemctl start caption-night
# Watch it:     journalctl -u caption-night -f
[Unit]
Description=Caption new photos at night (Memento)
Wants=docker.service
After=docker.service

[Service]
Type=oneshot
ExecStart={{ memento_extras_dir }}/caption-night.sh
ExecStopPost=-/usr/bin/docker rm -f caption-model caption-night
TimeoutStartSec=9h
Nice=19
