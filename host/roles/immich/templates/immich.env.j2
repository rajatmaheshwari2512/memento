# Managed by Ansible (host/roles/immich). Changes made on the server are overwritten.
# Based on Immich's example.env. Docs: https://docs.immich.app/install/environment-variables

UPLOAD_LOCATION={{ immich_upload_location }}
THUMB_LOCATION={{ immich_thumb_location }}
DB_DATA_LOCATION={{ immich_db_data_location }}
TZ={{ immich_timezone }}

# Pinned, never "v3" or "release", so upgrades only happen through Ansible.
IMMICH_VERSION={{ immich_version }}

DB_PASSWORD={{ immich_db_password }}
DB_USERNAME=postgres
DB_DATABASE_NAME=immich
