# Managed by Ansible (host/roles/backup). Changes made on the server are overwritten.
# Run by hand:  sudo systemctl start deep-archive-backup
# Watch it:     journalctl -u deep-archive-backup -f
[Unit]
Description=Copy the apps' files to Glacier Deep Archive, encrypted
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# Defines the "glacier" remote, and the encrypting remotes over it, for rclone (the
# script inherits these variables).
EnvironmentFile=/etc/deep-archive-backup/glacier.env
# The copies themselves, one folder after the other: see the script.
ExecStart=/etc/deep-archive-backup/backup.sh
# Be gentle: the apps get the CPU and disk first.
Nice=10
IOSchedulingClass=idle
