# Managed by Ansible (host/roles/backup). Changes made on the server are overwritten.
# Defines rclone remotes for deep-archive-backup.service, as environment variables
# (RCLONE_CONFIG_<REMOTE>_<OPTION>), so this role needs no rclone.conf of its own.

# "glacier": the S3 bucket in Deep Archive.
RCLONE_CONFIG_GLACIER_TYPE=s3
RCLONE_CONFIG_GLACIER_PROVIDER=AWS
RCLONE_CONFIG_GLACIER_REGION={{ backup_aws_region }}
RCLONE_CONFIG_GLACIER_ACCESS_KEY_ID={{ backup_access_key_id }}
RCLONE_CONFIG_GLACIER_SECRET_ACCESS_KEY={{ backup_secret_access_key }}
# Every upload goes straight to the cheapest class (Deep Archive).
RCLONE_CONFIG_GLACIER_STORAGE_CLASS=DEEP_ARCHIVE
RCLONE_CONFIG_GLACIER_NO_CHECK_BUCKET=true
{% for job in backup_jobs if job.enabled | default(true) | bool and job.encrypt_names is defined %}

# "archive_{{ job.name }}": glacier:<bucket>/{{ job.dest_path }} through rclone crypt, names included ({{ job.encrypt_names }}).
RCLONE_CONFIG_ARCHIVE_{{ job.name | upper }}_TYPE=crypt
RCLONE_CONFIG_ARCHIVE_{{ job.name | upper }}_REMOTE=glacier:{{ backup_bucket }}/{{ job.dest_path }}
RCLONE_CONFIG_ARCHIVE_{{ job.name | upper }}_PASSWORD={{ backup_crypt_password_obscured }}
RCLONE_CONFIG_ARCHIVE_{{ job.name | upper }}_PASSWORD2={{ backup_crypt_password2_obscured }}
RCLONE_CONFIG_ARCHIVE_{{ job.name | upper }}_FILENAME_ENCRYPTION=standard
RCLONE_CONFIG_ARCHIVE_{{ job.name | upper }}_DIRECTORY_NAME_ENCRYPTION=true
RCLONE_CONFIG_ARCHIVE_{{ job.name | upper }}_FILENAME_ENCODING={{ job.encrypt_names }}
{% endfor %}
