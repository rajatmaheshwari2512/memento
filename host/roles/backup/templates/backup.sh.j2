#!/bin/sh
# Managed by Ansible (host/roles/backup). Changes made on the server are overwritten.
# Copies each app's files to Glacier Deep Archive, one folder after the other. Run by
# deep-archive-backup.service, which also defines the rclone remotes (glacier.env).
# Everything arrives in the bucket encrypted, names included: plain files on the VM's disk go through an encrypting remote (archive_<name>); files on the Storage Box are already encrypted and copied as they are.
# copy (not sync): never deletes anything in the bucket.
# --size-only: compare sizes, not checksums; jobs with compare: modtime use size and time.
# --fast-list: list the bucket 1,000 files per request.
# A failed copy doesn't stop the next one, but the script ends with an error (systemctl status deep-archive-backup).

failed=""
{% for job in backup_jobs if job.enabled | default(true) | bool %}

{% if job.encrypt_names is defined %}
{% set left_out = ([job.weekly_only] if job.weekly_only is defined else []) + (job.skip_folders | default([])) %}
# {{ job.name }}: the plain files in {{ job.source }}, encrypted on the way.
{% if job.weekly_only is defined %}
# Its {{ job.weekly_only }}/ folder is left out here and copied once a week, below.
{% endif %}
{% for folder in job.skip_folders | default([]) %}
# {{ folder }}/ is left out: the app rebuilds it from the originals.
{% endfor %}
echo "{{ job.name }}: copying {{ job.source }} to glacier:{{ backup_bucket }}/{{ job.dest_path }}, encrypted"
if ! /usr/bin/rclone copy {{ job.source }} archive_{{ job.name }}: \
{% for folder in left_out %}
  --exclude '/{{ folder }}/**' \
{% endfor %}
{% else %}
{% if job.only_subfolder is defined %}
# {{ job.name }}: only each "{{ job.only_subfolder }}" folder ({{ backup_scrambled[job.name] }} is its
# scrambled name), so versions, trash, previews and logs stay out of Deep Archive.
{% else %}
# {{ job.name }}: the whole folder, already encrypted on the Storage Box.
{% endif %}
echo "{{ job.name }}: copying {{ job.source }} to glacier:{{ backup_bucket }}/{{ job.dest_path }}"
if ! /usr/bin/rclone copy {{ job.source }} glacier:{{ backup_bucket }}/{{ job.dest_path }} \
  --config /etc/rclone/rclone.conf \
{% if job.only_subfolder is defined %}
  --include '/*/{{ backup_scrambled[job.name] }}/**' \
{% endif %}
{% endif %}
{% if job.compare | default('size') == 'size' %}
  --size-only \
{% endif %}
  --fast-list \
  --transfers {{ backup_transfers }} \
  --checkers {{ backup_checkers }} \
  --stats 10m --stats-one-line -v; then
  failed="$failed {{ job.name }}"
fi
{% if job.weekly_only is defined %}

# {{ job.name }}, once a week (day {{ backup_weekly_day }}, 7 = Sunday): the newest file in {{ job.weekly_only }}/ is copied as {{ job.weekly_only }}/{{ job.weekly_as }}, replacing last week's.
if [ "$(date +%u)" = "{{ backup_weekly_day }}" ]; then
  newest=$(find {{ job.source }}/{{ job.weekly_only }} -maxdepth 1 -type f ! -name '.*' -printf '%T@ %p\n' | sort -n | tail -1 | cut -d' ' -f2-)
  if [ -n "$newest" ]; then
    echo "{{ job.name }}: weekly copy of $newest as {{ job.weekly_only }}/{{ job.weekly_as }}"
    if ! /usr/bin/rclone copyto "$newest" archive_{{ job.name }}:{{ job.weekly_only }}/{{ job.weekly_as }} \
      --ignore-times -v; then
      failed="$failed {{ job.name }}-weekly"
    fi
  else
    echo "{{ job.name }}: no file found in {{ job.weekly_only }}/ for the weekly copy"
    failed="$failed {{ job.name }}-weekly"
  fi
fi
{% endif %}
{% endfor %}

if [ -n "$failed" ]; then
  echo "These copies failed:$failed"
  exit 1
fi
echo "All copies done"
