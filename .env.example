# Memento's settings. Copy to .env and fill in what you need: cp .env.example .env
# Dev needs none of them. Prod needs the REQUIRED part, plus the optional parts you want;
# ./memento prod check says what's missing, and ./memento prod setup fills in the GENERATED part.
# One NAME=value per line. .env is never committed (.gitignore).

# ── DEV (all optional) ──────────────────────────────────────────────────────────────────────────
# AI Edit with the real Gemini; costs money per edit. Empty: a free fake.
DEV_GEMINI_API_KEY=
# 0: no smart search or faces. Empty: on.
DEV_ML=
# The website: container (the dev server, from IMMICH_SRC) or dist (a build). Empty: container.
DEV_WEB=
# With DEV_WEB=dist, the built website's folder. Empty: apps/web/dist/<Immich version>.
DEV_WEB_DIST=
# 1: no collages, recaps or Reduce noise 00:30–07:00, as in prod. Empty: any hour.
DEV_NIGHT_RULES=
# Time zone, like Europe/London. Empty: this computer's.
DEV_TZ=
# Immich's source with Memento's website, relative to the repo or absolute. Empty: immich.
IMMICH_SRC=

# ── DEV and PROD (optional) ─────────────────────────────────────────────────────────────────────
# Ask's reader model: a folder on this computer with config.json, tokenizer.json and model.onnx,
# relative to the repo or absolute. Empty: downloaded from Hugging Face at a fixed version (dev:
# into .local/reader-model/; prod: on the server).
READER_MODEL_DIR=
# Music for recap videos (deploy/music/tracks.md): a folder on this computer with the .mp3 files,
# relative to the repo or absolute; prod copies them to the server. Empty: .local/recap-music/tracks
# if it's there, else silent recaps.
MUSIC_DIR=

# ── PROD: REQUIRED ──────────────────────────────────────────────────────────────────────────────
# The address people open, like photos.example.com: a name in a domain you own, pointed at the
# server (CLOUDFLARE DNS below does that for you). Empty: the prod commands stop.
MEMENTO_DOMAIN=
# AI Edit's key: aistudio.google.com → Get API key, with billing on (each edit is paid, about
# $0.05). Empty: deploy stops.
GEMINI_API_KEY=
# The server's time zone, like Europe/London (the night captions, backups and AI Edit's daily
# limits follow it). Empty: Etc/UTC.
TZ=

# ── PROD: YOUR OWN SERVER (only if setup should NOT make an Oracle server) ─────────────────────
# Its SSH address: an IP address or a name. The server needs Ubuntu 24.04 (ARM64 or x86-64),
# about 2 cores, 12 GB of memory and room for your photos, ports 80 and 443 open to everyone
# (HTTPS), your SSH key for SERVER_USER, and sudo without a password. Empty: setup makes an
# Oracle server when the ORACLE part is filled in; deploy reaches the server at MEMENTO_DOMAIN.
SERVER_HOST=
# The SSH user on the server. Empty: ubuntu.
SERVER_USER=

# ── PROD: ORACLE SERVER (only if setup should make the server; leave SERVER_HOST empty) ────────
# Oracle Cloud's free ARM server (2 cores, 12 GB, 200 GB of disk), its network and a spending
# alert, recorded in infra/terraform.tfstate (back it up). MANUAL first: an Oracle Cloud account
# (cloud.oracle.com), then Oracle's CLI and `oci setup config` (writes ~/.oci/config and an API
# key; add the public key in Oracle's console, your profile → API keys).
# Your tenancy's OCID, ocid1.tenancy.oc1..…: the tenancy= line in ~/.oci/config. Empty: no Oracle server.
OCI_TENANCY_OCID=
# Which profile in ~/.oci/config. Empty: DEFAULT.
OCI_CONFIG_PROFILE=
# Your home region, like xx-city-1 (Oracle's console, top right). Empty: the profile's region in ~/.oci/config.
OCI_REGION=
# The SSH public key put on the server for ubuntu. Empty: ~/.ssh/id_ed25519.pub (make one: ssh-keygen -t ed25519).
SSH_PUBLIC_KEY_PATH=
# Who may reach SSH (port 22), like 203.0.113.7/32 for one address. Empty: 0.0.0.0/0, anyone (login is by key only).
SSH_ALLOWED_CIDR=
# The monthly spending alert: a whole number in your Oracle account's currency (Billing → Cost
# Analysis shows which; it may not be your country's). The server is free, so any spend means
# something isn't. Required with this part.
OCI_BUDGET_AMOUNT=
# Where Oracle emails that alert. Required with this part.
OCI_BUDGET_EMAIL=

# ── PROD: CLOUDFLARE DNS (only if your domain's DNS is on Cloudflare) ───────────────────────────
# Lets setup point MEMENTO_DOMAIN at the server (an A record, DNS only). dash.cloudflare.com →
# My Profile → API Tokens → Create Token → "Edit zone DNS", for your domain, plus Zone · Zone · Read.
# Empty: MANUAL: add
# that record yourself at your DNS provider.
CLOUDFLARE_API_TOKEN=
# Your domain in Cloudflare. Empty: MEMENTO_DOMAIN without its first part (photos.example.com → example.com).
CLOUDFLARE_ZONE=

# ── PROD: BACKUPS (only for nightly, encrypted off-site backups: S3 Glacier Deep Archive, ~$1/TB a month) ──
# The S3 bucket: a name unique across all of AWS, like memento-backup-<random letters>. Empty (and
# no backup keys): no backups, and deploy warns that nothing is copied off the server.
BACKUP_BUCKET_NAME=
# The bucket's AWS region. Empty: us-east-1.
AWS_REGION=
# Only for setup to make the bucket and its backup user: an AWS profile with admin rights in
# ~/.aws/credentials (aws configure --profile <name>). Empty, and no keys below: make the bucket
# and a user that may write to it yourself, and fill in BACKUP_ACCESS_KEY_ID and BACKUP_SECRET_ACCESS_KEY.
AWS_PROFILE=
# Or an admin's access keys instead of AWS_PROFILE (AWS console → IAM → Users → Security credentials).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── GENERATED: ./memento prod setup fills these in, and never changes one that's set ───────────
# BACK THEM UP (a password manager), with infra/terraform.tfstate if setup made anything (it's
# Terraform's only record of the server, DNS record and bucket). Losing them loses the database's
# password, the live albums' keys and every backup.
# Immich's database password: 16+ letters and digits. Set before the first deploy; the database keeps it.
IMMICH_DB_PASSWORD=
# Encrypts the keys live albums keep: what openssl rand -base64 32 prints.
MEMENTO_SECRET=
# The backup user's keys: from Terraform when setup makes the bucket; else yours (AWS console →
# IAM → the user → Security credentials).
BACKUP_ACCESS_KEY_ID=
BACKUP_SECRET_ACCESS_KEY=
# The backups' two encryption passwords, as rclone obscure prints them (setup shows them in plain
# once). Without them the backups can't be read.
BACKUP_CRYPT_PASSWORD_OBSCURED=
BACKUP_CRYPT_PASSWORD2_OBSCURED=
# The Android app's signing key's password (./memento android keystore, apps/android/build.sh).
ANDROID_KEYSTORE_PASSWORD=

# ── ANDROID (optional) ──────────────────────────────────────────────────────────────────────────
# The app's signing key. Empty: ~/.config/selfphotos/android/selfphotos-immich.jks
# (./memento android keystore makes one there; never replaces one).
ANDROID_KEYSTORE_PATH=
# The key's name in it. Empty: selfphotos.
ANDROID_KEYSTORE_ALIAS=
