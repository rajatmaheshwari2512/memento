# Memento's settings. Copy to .env and fill in what you need. Dev needs none of them.

# ── DEV (all optional) ──────────────────────────────────────────────────────────────────────────
# AI Edit with the real Gemini; costs money per edit. Empty: a free fake.
DEV_GEMINI_API_KEY=
# 0: no smart search or faces. Empty: on.
DEV_ML=
# The website: container (the dev server, from IMMICH_SRC) or dist (a build). Empty: container.
DEV_WEB=
# With DEV_WEB=dist, the built website's folder. Empty: apps/web/dist/<Immich version>.
DEV_WEB_DIST=
# 1: no collages, recaps or Reduce noise 00:30–07:00, as in prod. Empty: any hour.
DEV_NIGHT_RULES=
# Time zone, like Asia/Kolkata. Empty: this computer's.
DEV_TZ=

# ── Dev now, prod later ───────────────────────────────────────────────────────────────────────────
# Immich's source with Memento's website, relative to the repo or absolute. Empty: immich.
IMMICH_SRC=
# Ask's reader model folder (config.json, tokenizer.json, model.onnx). Empty: downloaded from Hugging Face.
READER_MODEL_DIR=
# Music for recap videos. Empty: .local/recap-music/tracks if there, else silent recaps.
MUSIC_DIR=

# ── PROD: the server ─────────────────────────────────────────────────────────────────────────────
# The address people open, like photos.example.com.
MEMENTO_DOMAIN=
# SSH address of the server. Empty: MEMENTO_DOMAIN.
SERVER_HOST=
# SSH user on the server. Empty: ubuntu.
SERVER_USER=

# ── PROD: secrets (keep a copy in your password manager) ────────────────────────────────────────────
# AI Edit. aistudio.google.com → API keys; paid per edit.
GEMINI_API_KEY=
# Immich's database password: 16+ letters and digits.
IMMICH_DB_PASSWORD=
# Encrypts what live albums and memories keep: openssl rand -base64 32
MEMENTO_SECRET=
# Backups: the S3 bucket and the backup user's keys (terraform output in infra/).
BACKUP_BUCKET_NAME=
BACKUP_ACCESS_KEY_ID=
BACKUP_SECRET_ACCESS_KEY=
# Backup encryption, as rclone obscure prints them. Without these the backups can't be read.
BACKUP_CRYPT_PASSWORD_OBSCURED=
BACKUP_CRYPT_PASSWORD2_OBSCURED=
# The Android signing key's password (apps/android/build.sh).
ANDROID_KEYSTORE_PASSWORD=
