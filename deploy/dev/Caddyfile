# Dev's proxy at http://localhost:8091 (deploy/dev/memento.yml).
#   /api, /api/*, /.well-known/immich   Immich
#   /extras, /extras/*                  memento-extras
#   /__local_login                      logs in as the test admin, then opens /photos
#   everything else                     the website (WEB_UPSTREAM)
{
	admin off
	auto_https off
	persist_config off
}

http://localhost:8091, http://127.0.0.1:8091 {
	handle /__local_login {
		header +Set-Cookie "immich_access_token={$LOCAL_TOKEN}; Path=/; HttpOnly; SameSite=Lax"
		header +Set-Cookie "immich_auth_type=password; Path=/; SameSite=Lax"
		header +Set-Cookie "immich_is_authenticated=true; Path=/; SameSite=Lax"
		redir * /photos 302
	}

	@api path /api /api/* /.well-known/immich
	handle @api {
		reverse_proxy immich-server:2283
	}

	@extras path /extras /extras/*
	handle @extras {
		uri strip_prefix /extras
		encode zstd gzip
		reverse_proxy memento-extras:3005
	}

	handle {
		reverse_proxy {$WEB_UPSTREAM}
	}
}
